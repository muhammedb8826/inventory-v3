# Backend API (NestJS inventory-api) — must include /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-only upstream used by the HttpOnly session proxy
API_URL=http://localhost:3001/api/v1

# Public FRONTEND origin when running behind cPanel/reverse proxies.
# Set this in the frontend cPanel environment, then restart the Node.js app.
# APP_ORIGIN=https://factory.vgatefurnishing.com
